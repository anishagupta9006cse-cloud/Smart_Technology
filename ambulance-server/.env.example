# Copy these into Render > your service > Environment. Never put real passwords in GitHub.

# MongoDB Atlas connection string (makes your data permanent). Example:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=amburoute

# Password for /admin (data entry) and /admin/live (command centre live map).
# If this line is missing, the default code Anisha_9631 is used (hackathon). CHANGE IT for real use.
ADMIN_CODE=Anisha_9631

# Access codes the apps must send. The apps already contain Anisha_9631, so use the SAME code in both.
# (leave both empty to allow everyone)
DRIVER_CODE=Anisha_9631
POLICE_CODE=Anisha_9631

# Optional: public address of this server, used in the family tracking link.
# Normally not needed (it is detected automatically).
PUBLIC_URL=

# true = only ambulances added in the admin page can start a trip
REQUIRE_REGISTERED_AMBULANCE=false

NODE_VERSION=20

# ---------------- version 5 ----------------
# true = drivers and police MUST log in with their own mobile number + OTP (shared code stops working for them)
REQUIRE_OTP=false
# false = only numbers added by the admin (Command centre > OTP users) can log in
OTP_SELF_SIGNUP=true
# SMS for OTP. Set ONE of them. If none is set, DEMO mode: the OTP is shown in the app (good for the hackathon).
FAST2SMS_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Push alerts when apps are closed (free ntfy.sh). 0 = off. You can also run your own ntfy server.
NTFY_ENABLED=1
NTFY_URL=https://ntfy.sh
# secret used to make the push topic names hard to guess
PUSH_SALT=change-me-to-something-random
