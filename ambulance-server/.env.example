# Copy these into Render > your service > Environment. Never put real passwords in GitHub.

# MongoDB Atlas connection string (makes your data permanent). Example:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=amburoute

# Password for the /admin page (data entry). If empty, the admin page is switched off.
ADMIN_CODE=

# Access codes the apps must send. The apps already contain Anisha_9631, so use the SAME code in both.
# (leave both empty to allow everyone)
DRIVER_CODE=Anisha_9631
POLICE_CODE=Anisha_9631

# Optional: public address of this server, used in the family tracking link.
# Normally not needed (it is detected automatically).
PUBLIC_URL=

# true = only ambulances added in the admin page can start a trip
REQUIRE_REGISTERED_AMBULANCE=false

NODE_VERSION=20
